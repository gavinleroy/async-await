\newtcolorbox{notebox}[2]{%
  enhanced,
  sharp corners,
  boxrule=0.8pt,
  colframe=#2!70!black,
  colback=#2!5!white,
  coltitle=#2!80!black,
  fonttitle=\bfseries\sffamily\tiny,
  attach boxed title to top left={xshift=12pt, yshift=-2pt},
  boxed title style={size=minimal, colback=white},
  title={Note -- #1},
}

