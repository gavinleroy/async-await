    {\hltikz{#1}{#2}{\(\textstyle#3\)}}%
    {\hltikz{#1}{#2}{\(\scriptstyle#3\)}}%
    {\hltikz{#1}{#2}{\(\scriptscriptstyle#3\)}}%
}

