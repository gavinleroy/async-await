\newcommand{\hltikz}[3]{%
  \kern-1.5pt% cancel left horizontal padding from text flow
  \tikz[baseline=(X.base)]\node[%
    rounded corners=1pt,%
    inner xsep=1.5pt,%   % horizontal pad (split out from inner sep=3pt)
    inner ysep=3pt,%     % keep vertical pad so box height is unchanged
    text depth=0pt,%
    shade,%
    shading=radial,%
    inner color=#1!95,%
    outer color=#1!60,%
    text opacity=1.0,%
    text=#2%
  ](X){#3};%
  \kern-1.5pt% cancel right horizontal padding -> comma sits flush
}
