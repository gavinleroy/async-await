% 1. Helper macro for drawing the colored circles
\newcommand{\legendmark}[1]{\tikz[baseline=-0.5ex]\draw[#1,fill=#1] (0,0) circle (0.6ex);\,}

% 2. Define your "dictionary" of fixed properties
\csdef{legenditem@eag}{\legendmark{P1C1}\small\Eagerness}
\csdef{legenditem@ext}{\legendmark{P1C2}\small\Extent}
\csdef{legenditem@ref}{\legendmark{P1C3}\small\References}
\csdef{legenditem@des}{\legendmark{P1C4}\small\Destruction}
\csdef{legenditem@pro}{\legendmark{P1C5}\small\Propagation}
\csdef{legenditem@sus}{\legendmark{P1C6}\small\Suspension}
\csdef{legenditem@can}{\legendmark{P1C7}\small\Cancellation}

% 3. The newly centered macro
\newcommand{\makelegend}[1]{%
  \begin{center} % <--- Centers the legend and enforces a line break after
    \def\legendsep{}% 
    \renewcommand*{\do}[1]{%
      \legendsep 
      \csuse{legenditem@##1}% 
      \def\legendsep{\hspace{1.5em}}% 
    }%
    \docsvlist{#1}% 
  \end{center}
}

